* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# GitHub recusa arquivos acima de 100 MB. O .wasm deste build passa de 200 MB,
# e os contêineres de conteúdo crescem a cada cook.
*.wasm filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text
*.ucas filter=lfs diff=lfs merge=lfs -text
*.utoc filter=lfs diff=lfs merge=lfs -text

*.br binary
*.bin binary
*.ushaderbytecode binary
*.stinfo binary
